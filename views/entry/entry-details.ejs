<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
</head>
<body>
    <%- include('../partials/navbar') %>
    <h1>Entry List</h1>

    <h3>Title: <%= entry.title %></h3> 
    <p>Body: <%= entry.entryBody %></p>
    <% if(entry.isPublic) {%>
        <p>The Entry is Public</p>
    <% }else{ %>
        <p>The Entry is Private</p>
    <% } %>
    <p>Owner: <%= entry.owner.username %></p>
    
    <% if(user){ %>
        <% if(String(entry.owner._id) === user._id){ %>
            <form action="/entries/<%= entry._id %>/edit" method="get">
                <button>Edit</button>
            </form>
            <form action="/entries/<%= entry._id %>/delete?_method=DELETE" method="post">
                <button>Delete</button>
            </form>
        <% } %>
    <% } %>
</body>
</html>